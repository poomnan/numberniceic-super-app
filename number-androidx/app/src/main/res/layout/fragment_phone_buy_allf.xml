<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coor_phonebuy"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.phone.PhoneBuyAllF">


<androidx.recyclerview.widget.RecyclerView
    android:id="@+id/recycleview_phone_sell"
    tools:listitem="@layout/item_head_phonesell"

    android:layout_width="match_parent"
    android:layout_height="wrap_content">


</androidx.recyclerview.widget.RecyclerView>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F7F6F6">

        <ProgressBar

            android:id="@+id/progressbar_phone_buyall"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="30dp"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:paddingTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FAF9F6"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:src="@drawable/ic_clover" />

                <TextView
                    android:id="@+id/txt_percent_d"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:padding="9dp"
                    android:text="ซื้อเบอร์มงคล หรือ เปิดดวงชะตา"
                    android:textColor="#04B40B"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="ซื้อเบอร์มงคล หรือ เปิดดวงชะตา" />


                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_open_miracle"
                    android:text="CLICK"
                    android:textSize="11sp"
                    android:textColor="#FFF"
                    app:chipBackgroundColor="#00b106"
                    app:chipStrokeWidth="2dp"
                    app:chipStrokeColor="#FFF"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp" />

            </LinearLayout>





        </LinearLayout>

    </FrameLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>