<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Level 1: Outer Aura (Opaque Emerald) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <stroke android:width="4dp" android:color="#FF8DE425" />
            <solid android:color="#00FFFFFF" />
        </shape>
    </item>
    
    <!-- Level 2: Middle Glow (Opaque Gold) -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="#FFFFD700" />
            <solid android:color="#00FFFFFF" />
        </shape>
    </item>

    <!-- Level 3: Core Magic Line (Vivid Yellow) -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <stroke android:width="1.5dp" android:color="#FFFFFF00" />
            <solid android:color="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
