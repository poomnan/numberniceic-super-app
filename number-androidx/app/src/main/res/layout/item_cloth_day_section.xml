<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable name="title" type="String"/>
    </data>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EBE8D5"
            android:padding="4dp"
            android:paddingStart="16dp"
            android:text="@{title}"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="16sp" />

        <!-- Good Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:src="@drawable/icon_checked" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:id="@+id/chip_container_good"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#F0F0EE"
                        android:orientation="horizontal"
                        android:padding="8dp">
                        <androidx.cardview.widget.CardView android:id="@+id/chipD1" android:layout_width="14dp" android:layout_height="14dp" app:cardCornerRadius="7dp" app:cardElevation="0dp" />
                        <androidx.cardview.widget.CardView android:id="@+id/chipD2" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="3dp" app:cardCornerRadius="7dp" app:cardElevation="0dp" />
                        <androidx.cardview.widget.CardView android:id="@+id/chipD3" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="3dp" app:cardCornerRadius="7dp" app:cardElevation="0dp" />
                        <androidx.cardview.widget.CardView android:id="@+id/chipD4" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="3dp" app:cardCornerRadius="7dp" app:cardElevation="0dp" />
                        <androidx.cardview.widget.CardView android:id="@+id/chipD5" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="3dp" app:cardCornerRadius="7dp" app:cardElevation="0dp" />
                        <androidx.cardview.widget.CardView android:id="@+id/chipD6" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="3dp" app:cardCornerRadius="7dp" app:cardElevation="0dp" />
                        <androidx.cardview.widget.CardView android:id="@+id/chipD7" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="3dp" app:cardCornerRadius="7dp" app:cardElevation="0dp" />
                        <androidx.cardview.widget.CardView android:id="@+id/chipD8" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="3dp" app:cardCornerRadius="7dp" app:cardElevation="0dp" />
                        <androidx.cardview.widget.CardView android:id="@+id/chipD9" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="3dp" app:cardCornerRadius="7dp" app:cardElevation="0dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="สีมงคล"
                    android:textColor="#2E7D32"
                    android:textSize="15sp" />

            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginStart="62dp" />

        <!-- Bad Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:src="@drawable/icon_cancel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:id="@+id/chip_container_bad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#F0F0EE"
                        android:orientation="horizontal"
                        android:padding="8dp">
                        <androidx.cardview.widget.CardView android:id="@+id/chipR1" android:layout_width="14dp" android:layout_height="14dp" app:cardCornerRadius="7dp" app:cardElevation="0dp" />
                        <androidx.cardview.widget.CardView android:id="@+id/chipR2" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="3dp" app:cardCornerRadius="7dp" app:cardElevation="0dp" />
                        <androidx.cardview.widget.CardView android:id="@+id/chipR3" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="3dp" app:cardCornerRadius="7dp" app:cardElevation="0dp" />
                        <androidx.cardview.widget.CardView android:id="@+id/chipR4" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="3dp" app:cardCornerRadius="7dp" app:cardElevation="0dp" />
                        <androidx.cardview.widget.CardView android:id="@+id/chipR5" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="3dp" app:cardCornerRadius="7dp" app:cardElevation="0dp" />
                        <androidx.cardview.widget.CardView android:id="@+id/chipR6" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="3dp" app:cardCornerRadius="7dp" app:cardElevation="0dp" />
                        <androidx.cardview.widget.CardView android:id="@+id/chipR7" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="3dp" app:cardCornerRadius="7dp" app:cardElevation="0dp" />
                        <androidx.cardview.widget.CardView android:id="@+id/chipR8" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="3dp" app:cardCornerRadius="7dp" app:cardElevation="0dp" />
                        <androidx.cardview.widget.CardView android:id="@+id/chipR9" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="3dp" app:cardCornerRadius="7dp" app:cardElevation="0dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="สีอัปมงคล"
                    android:textColor="#D32F2F"
                    android:textSize="15sp" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</layout>
