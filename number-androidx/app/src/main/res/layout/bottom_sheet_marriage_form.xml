<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:padding="20dp">


    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#E0E0E0" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/valentines_day" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/sarabun_semibold"
                    android:text="ตรวจดวงสมพงศ์หาฤกษ์แต่งงาน"
                    android:textColor="#333333"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/sarabun_regular"
                android:text="กรุณาระบุวันเดือนปีเกิดของคู่บ่าวสาวเพื่อคำนวณฤกษ์แต่งงานที่เป็นมงคลที่สุด"
                android:textColor="#666666"
                android:textSize="14sp" />

            <!-- Groom Date Picker -->
            <!--ANCHOR: Husband Date Picker (วันเกิดเจ้าบ่าว) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/sarabun_semibold"
                android:text="วันเดือนปีเกิด เจ้าบ่าว"
                android:textColor="#039BE5"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <!-- Date Dropdowns Row (Fixed Missing Day Number) -->
                <LinearLayout
                    android:id="@+id/layout_groom_date_spinners"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1.5"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_white_rounded_with_stroke"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="4dp">

                    <Spinner
                        android:id="@+id/spinner_groom_day"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.0"
                        android:paddingHorizontal="0dp"
                        android:background="@android:color/transparent"
                        android:gravity="center" />

                    <Spinner
                        android:id="@+id/spinner_groom_month"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.5"
                        android:paddingHorizontal="0dp"
                        android:background="@android:color/transparent"
                        android:gravity="center" />

                    <Spinner
                        android:id="@+id/spinner_groom_year"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2.2"
                        android:paddingHorizontal="0dp"
                        android:background="@android:color/transparent"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Time & Province Dropdowns Row (Rebalanced) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1.5"
                    android:background="@drawable/bg_white_rounded_with_stroke"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="4dp">

                    <Spinner
                        android:id="@+id/spinner_groom_hour"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.2"
                        android:paddingHorizontal="0dp"
                        android:background="@android:color/transparent"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spinner_groom_minute"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.2"
                        android:paddingHorizontal="0dp"
                        android:background="@android:color/transparent"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sarabun_regular"
                        android:text="น."
                        android:textColor="#333333"
                        android:textSize="10sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="14dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="#EEEEEE" />

                    <Spinner
                        android:id="@+id/spinner_groom_province"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2.8"
                        android:paddingHorizontal="0dp"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical|start" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_groom_kalagni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="#FDECEE"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txt_groom_kalagni"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun_regular"
            android:textColor="#D32F2F"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Bride Date Picker -->
            <!--ANCHOR: Wife Date Picker (วันเกิดเจ้าสาว) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/sarabun_semibold"
                android:text="วันเดือนปีเกิด เจ้าสาว"
                android:textColor="#039BE5"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <!-- Date Dropdowns Row (Bride - Fixed Missing Day Number) -->
                <LinearLayout
                    android:id="@+id/layout_bride_date_spinners"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1.5"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_white_rounded_with_stroke"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="4dp">

                    <Spinner
                        android:id="@+id/spinner_bride_day"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.0"
                        android:paddingHorizontal="0dp"
                        android:background="@android:color/transparent"
                        android:gravity="center" />

                    <Spinner
                        android:id="@+id/spinner_bride_month"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.5"
                        android:paddingHorizontal="0dp"
                        android:background="@android:color/transparent"
                        android:gravity="center" />

                    <Spinner
                        android:id="@+id/spinner_bride_year"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2.2"
                        android:paddingHorizontal="0dp"
                        android:background="@android:color/transparent"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Time & Province Dropdowns Row (Bride - Rebalanced) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1.5"
                    android:background="@drawable/bg_white_rounded_with_stroke"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="4dp">

                    <Spinner
                        android:id="@+id/spinner_bride_hour"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.2"
                        android:paddingHorizontal="0dp"
                        android:background="@android:color/transparent"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spinner_bride_minute"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.2"
                        android:paddingHorizontal="0dp"
                        android:background="@android:color/transparent"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sarabun_regular"
                        android:text="น."
                        android:textColor="#333333"
                        android:textSize="10sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="14dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="#EEEEEE" />

                    <Spinner
                        android:id="@+id/spinner_bride_province"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2.8"
                        android:paddingHorizontal="0dp"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical|start" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_bride_kalagni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="#FDECEE"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txt_bride_kalagni"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sarabun_regular"
            android:textColor="#D32F2F"
                    android:textSize="14sp" />
            </LinearLayout>

            <!--ANCHOR: Find Marriage Date Button (ปุ่มหาฤกษ์แต่งงาน) -->
            <Button
                android:id="@+id/btn_find_marriage_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/button_purple_rounded"
                android:backgroundTint="#FF4081"
                android:fontFamily="@font/sarabun_semibold"
                android:paddingVertical="6dp"
                android:text="หาฤกษ์แต่งงาน"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_marriage_form_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:padding="12dp"
                android:background="#F2F2F2"
                android:fontFamily="@font/sarabun_regular"
                android:textColor="#111111"
                android:textSize="12sp"
                android:text="หมายเหตุ: รายการนี้เป็นค่าอ้างอิงของปีปัจจุบัน ตอนค้นหาฤกษ์จริงระบบจะคำนวณอายุย่างและวันอัปมงคลใหม่ให้ตามแต่ละปีของวันที่ค้นหา" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
