<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_rounded">

    <TextView
        android:id="@+id/txtHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ทำนายฝันกับคุณนิน"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:gravity="center"
        android:background="#2E2E2E" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp"
        tools:listitem="@layout/item_ninin_chat_message"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" 
        app:stackFromEnd="true"/>
    
    <ProgressBar
         android:id="@+id/progressBar"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_gravity="center"
         android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/inputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#1E1E1E">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="พิมพ์คำสั่ง..."
            android:textColorHint="#CCCCCC"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_white_rounded_no_stroke"
            android:backgroundTint="#333333"
            android:padding="12dp"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4" />

        <Button
            android:id="@+id/btnDebugExpire"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:text="ทำให้หมดสิทธิ์"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_menu_home"
            app:tint="#FFFFFF"
            android:background="@drawable/circle_primary"
            android:padding="12dp"
            android:contentDescription="Send" />

    </LinearLayout>

</LinearLayout>
