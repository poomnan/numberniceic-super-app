<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="nameSurObs"
            type="com.numberniceic.ui.namesur.NameSurObs" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_namesur"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#EEEEEE"
            tools:context=".ui.namesur.NameSurF">


            <androidx.core.widget.NestedScrollView
                android:id="@+id/nestScView"

                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">


                    <LinearLayout
                        android:layout_marginTop="0.5dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#FFB300"
                            android:orientation="horizontal">


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginStart="10dp"
                                android:fontFamily="@font/browa_0"
                                android:textStyle="bold"
                                android:gravity="end|center_vertical"
                                android:text="เลือกวันเกิด "
                                android:textColor="#ffffff"
                                android:textSize="28sp"
                                />


                            <Spinner
                                android:layout_margin="1dp"
                                android:id="@+id/days_spinner"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                />

                        </LinearLayout>


                        <LinearLayout
                            android:background="#Ffffff"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_marginStart="20dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:text="ชื่อจริง  :"
                                android:textStyle="bold"
                                android:textSize="28sp" />


                            <AutoCompleteTextView
                                android:id="@+id/edtName"
                                android:layout_width="240dp"
                                android:layout_height="wrap_content"
                                android:paddingStart="9dp"
                                android:hint="ชื่อ"
                                android:imeOptions="actionDone"
                                android:inputType="text"
                                android:maxLength="20"
                                android:maxLines="1"

                                android:textSize="24sp"
                                android:textStyle="bold" />


                        </LinearLayout>

                        <LinearLayout
                            android:background="#FFF"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_marginStart="20dp"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:text="นามสกุล :"
                                android:textSize="24sp" />


                            <AutoCompleteTextView
                                android:id="@+id/edtSurName"
                                android:layout_width="240dp"
                                android:layout_height="wrap_content"
                                android:paddingStart="9dp"
                                android:hint="สกุล"
                                android:layout_marginStart="4dp"
                                android:imeOptions="actionDone"
                                android:inputType="text"
                                android:maxLength="20"
                                android:maxLines="1"

                                android:textSize="24sp"
                                android:textStyle="bold" />


                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#6CBD15"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnNameSurClear"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ล้าง"
                                    app:backgroundTint="#6CBD15"
                                    app:cornerRadius="9dp"
                                    app:icon="@drawable/ic_stop_48"
                                    app:iconSize="24dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnNameSurMiracle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ผลทำนาย"
                                    app:backgroundTint="#6CBD15"
                                    android:layout_marginStart="9dp"
                                    app:cornerRadius="9dp"
                                    app:icon="@drawable/ic_eye_48"
                                    app:iconSize="24dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnNameSurCal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="9dp"
                                    android:text="ถอดรหัส"
                                    app:backgroundTint="#6CBD15"
                                    app:cornerRadius="9dp"
                                    app:icon="@drawable/ic_clover"
                                    app:iconSize="24dp" />

                            </LinearLayout>
                        </LinearLayout>




                    </LinearLayout>

                    <RelativeLayout
                        android:id="@+id/fragment_ad_container_namesur"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">


                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginEnd="6dp"
                        app:cardBackgroundColor="#efebe9"
                        app:cardCornerRadius="6dp">




                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#404040"
                                android:padding="4dp"
                                android:text="คำนวณเลขศาสตร์"
                                android:textColor="#FDD835"
                                android:textSize="18sp"
                                android:textStyle="bold" />


                            <LinearLayout
                                android:background="#FFFfff"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:orientation="horizontal"
                                android:padding="4dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/browa_0"
                                    android:text="เลขเรียงชื่อ : "
                                    android:textSize="20sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtSatName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@{nameSurObs.satName}"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    tools:text="n" />


                            </LinearLayout>

                            <View

