<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.phone.PhoneBuyF">


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/lin_summery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:background="#f1efef"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#000000">

                    <TextView
                        android:id="@+id/txtTitleSalum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:padding="3dp"
                        android:text="เลือกซื้อเบอร์โทรศัพท์มงคล"
                        android:textColor="#FAF19F"
                        android:textSize="18sp" />



                </RelativeLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:background="#FFFFFF"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/img_d"
                        android:layout_width="15dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:src="@drawable/ic_clover"
                        tools:src="@drawable/ic_clover" />

                    <TextView
                        android:id="@+id/txt_report_d"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="8"
                        android:textStyle="bold"
                        android:text="เบอร์โทรศัพท์มงคล VIP"
                        android:textColor="#3fa33f"
                        android:textSize="16sp"
                        tools:text="เบอร์โทรศัพท์มงคล VIP" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:background="#ffffff"
                    android:orientation="horizontal">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">


                        <LinearLayout
                            android:layout_marginStart="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView

                                android:layout_gravity="center_vertical"
                                android:src="@drawable/ic_vip02"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                />

                            <com.google.android.material.button.MaterialButton
                                android:layout_marginStart="3dp"
                                android:id="@+id/chip_0951424515"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:chipBackgroundColor="#FFF"
                                android:text="09-5142-4515 (36) ราคา 999,999 บาท"
                                android:textColor="#4A96EB"
                                android:textSize="15sp"/>



                        </LinearLayout>

                        <LinearLayout
                            android:layout_marginStart="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:src="@drawable/ic_vip02"

                                android:layout_width="30dp"
                                android:layout_gravity="center_vertical"
                                android:layout_height="30dp"
                                />

                            <com.google.android.material.button.MaterialButton
                                android:layout_marginStart="3dp"
                                android:id="@+id/chip_0956515454"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:chipBackgroundColor="#FFF"
                                android:text="09-5651-5454 (44) ราคา 999,999 บาท"
                                android:textColor="#4A96EB"
                                android:textSize="15sp"/>


                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginStart="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:src="@drawable/ic_vip02"

                                android:layout_gravity="center_vertical"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                />


                         <com.google.android.material.button.MaterialButton
                                android:layout_marginStart="3dp"
                                android:id="@+id/chip_0959546364"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:chipBackgroundColor="#FFF"
                                android:text="09-5954-6364 (41) ราคา 299,999 บาท"
                                android:textColor="#4A96EB"
                                android:textSize="15sp"/>






                        </LinearLayout>


                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">


                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_show_phone_all_number"
                            app:chipIcon="@drawable/icon_luckycat"
                            android:text="เลือกดูเบอร์ทั้งหมด"

                            android:textStyle="bold"
                            android:layout_marginStart="10dp"
                            app:chipBackgroundColor="#F8F7F7"
                            app:chipIconSize="30dp"
                            android:textColor="#FA801B"
                            android:layout_gravity="end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                        </RelativeLayout>


                    </LinearLayout>


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">


                    </RelativeLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FAF9F6"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:src="@drawable/ic_clover" />

                    <TextView
                        android:id="@+id/txt_percent_d"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:padding="9dp"
                        android:textColor="#04B40B"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="ซื้อเบอร์มงคล หรือ เปิดดวงชะตา"
                        tools:text="ซื้อเบอร์มงคล หรือ เปิดดวงชะตา" />


                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_open_miracle"
                        android:text="CLICK"
                        android:textSize="11sp"
                        android:textColor="#FFF"
                        app:chipBackgroundColor="#00b106"

                        app:chipStrokeWidth="2dp"
                        app:chipStrokeColor="#FFF"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp" />

                </LinearLayout>



            </LinearLayout>


            <androidx.cardview.widget.CardView
                android:id="@+id/cardRe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_margin="3dp"
                app:cardElevation="10dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/linHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#2d2d2d"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtHeadTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#2d2d2d"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:text="ดีที่สุด เสี่ยงน้อยที่สุด คุ้มค่าที่สุด ต้องคำนึงถึง"
                            android:textColor="#FFF"
                            android:textSize="16sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/linDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#5c5c5c"
                        android:orientation="vertical"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:paddingBottom="16dp">


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/browa_0"
                                android:text="1. "
                                android:textColor="#F7E337"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/browa_0"
                                android:text="ควรต้องเป็นเลขโฉลกที่มากับพื้นดวง จึงต้องเปิดดวงเจาะเลขจาก วัน เดือน ปีเกิด เวลาเกิด จังหวัดที่เกิด รวมทั้งตัวเลขทั้งดีและร้าย ที่มีสะสมอยู่ในชีวิตของบุคคลนั้นๆก่อนจึงจะดีที่สุด"
                                android:textColor="#FFF"
                                android:textSize="20sp" />
                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/browa_0"
                                android:text="2. "
                                android:textColor="#F7E337"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:fontFamily="@font/browa_0"
                                android:text="เมื่อเปิดดวงเจาะเลข วิเคราะห์ดวง วิเคราะห์เลขแล้วควรเลี่ยงเลขกรรมเลขร้ายที่ติดตามในพื้นดวงของเจ้าชะตา แล้ววางเลขบุญเลขดีเพื่อส่งเสริมดวงชะตาตามตำแหน่ง"
                                android:textColor="#FFF"
                                android:textSize="20sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/browa_0"
                                android:text="3. "
                                android:textColor="#F7E337"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:fontFamily="@font/browa_0"
                                android:text="เลขทุกคู่ในเบอร์ต้องดี มีพลังเต็ม สลับหน้าสลับหลังแล้วต้องดี"
                                android:textColor="#FFF"
                                android:textSize="20sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/browa_0"
                                android:text="4. "
                                android:textColor="#F7E337"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:fontFamily="@font/browa_0"
                                android:text="ต้องมีเลขแฝงดีทุกคู่ หรือ ถ้าหาไม่ได้ ต้องพยายามให้มีเลขแฝงที่มีความหมายไปในทางร้ายรุนแรงน้อยที่สุด"
                                android:textColor="#FFF"
                                android:textSize="20sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/browa_0"
                                android:text="5. "
                                android:textColor="#F7E337"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:fontFamily="@font/browa_0"
                                android:text="ถ้าหาเบอร์ที่ดีทุกคู่ทั้งเลขหลักเลขแฝงไม่ได้จริงๆให้มองหาเบอร์ที่มีสี่คู่ท้ายดี หรือ อย่างน้อยๆต้องมีสามคู่ท้ายดีในเบอร์ และคู่ที่เหลือต้องไม่ใช่เลขร้ายรุนแรง"
                                android:textColor="#FFF"
                                android:textSize="20sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/browa_0"
                                android:text="6. "
                                android:textColor="#F7E337"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:fontFamily="@font/browa_0"
                                android:text="โดยเฉพาะเลขหลักเลขแฝงในสองคู่ท้าย สำคัญมากต้องดี ควรเป็นเลขถูกโฉลกดวงและต้องเลือกให้ดีกับตนให้มากที่สุด"
                                android:textColor="#FFF"
                                android:textSize="20sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/browa_0"
                                android:text="7. "
                                android:textColor="#F7E337"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:fontFamily="@font/browa_0"
                                android:text="และสุดท้ายที่สำคัญคือ เบอร์นั้นต้องได้ผลรวมที่ดีจึงจะดีที่สุด แต่ถ้าคุณมีงบประมาณจำกัด จำเป็นต้องใช้ไปก่อน ถ้าเลขในเบอร์มันดีกว่าเบอร์เก่าเยอะมากแล้ว แถมเป็นเลขโฉลกดวง นั่นก็อนุโลมให้ใช้ได้ก่อนชั่วคราว ระวังถ้าผลรวมเบอร์ไม่ดีต้องย้อนกลับไปดูเลขภายในเบอร์ว่า มันมีเลขคุ้มครองและมีเลขพลังเต็มเยอะไม่ หรือมีเลขอันตรายเยอะรึเปล่า ถ้าในเบอร์มีเลขอันตรายเยอะ แถมผลรวมยังอันตรายต้องระวังให้มาก ถ้าเลือกได้อย่าใช้ โดยผลรวมเลขอันตรายที่เราอนุโลมให้ใช้ได้คือ 47,35,53,40,52,39,25,28,38 และ43,49 (เลขเหล่านี้ใช้ได้เฉพาะบางคนต้องเช็คพื้นดวงก่อน และต้องดูเลขคู่ในเบอร์ภายในประกอบ"
                                android:textColor="#FFF"
                                android:textSize="20sp" />
                        </LinearLayout>


                    </LinearLayout>

                </LinearLayout>


            </androidx.cardview.widget.CardView>
           <include layout="@layout/item_footer" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


</androidx.coordinatorlayout.widget.CoordinatorLayout>