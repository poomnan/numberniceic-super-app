    <LinearLayout
        android:id="@+id/linear_news_item1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/ripple_recycler"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <ImageView
                android:id="@+id/img_news1"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:src="@drawable/gold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#80000000">

                <TextView
                    android:id="@+id/txt_header_news1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginStart="9dp"
                    android:layout_marginEnd="9dp"
                    android:textColor="#FFFFFF"

                    android:textSize="18sp"

                    tools:text="ทำบุญปรางวันเสาร์" />
            </FrameLayout>

        </FrameLayout>

        <FrameLayout
            android:background="#FFF"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <TextView

                android:id="@+id/txt_desc_news1"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/browa_0"
                android:maxLines="3"
                android:textSize="20sp"
                tools:text="ไปบูชาพระพุทธรูปปางนาคปรก 9 นิ้ว หรือ 5 นิ้ว หรือ มากกว่าก็เยี่ยมเลย โดยหาได้ที่ร้านขายเครื่องสังฆภัณฑ์ (ให้บูชาพระประจำวันเสาร์เนื้อทองเหลืองหรือเนื้อสัมฤทธิ์เท่านั้น) **พระนี้ก่อนนำไปถวาย ต้องบอกกล่าวว่า เมื่อเรานำไปถวายแล้ว ขอให้พระท่านนำเอาพระไปตั้งให้คนได้กราบไหว้ด้วยนะคะ จะดีมาก" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@android:color/darker_gray" />


    </LinearLayout>

