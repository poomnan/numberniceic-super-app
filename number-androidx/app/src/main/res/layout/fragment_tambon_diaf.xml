<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    tools:context=".ui.tambon.TambonDiaf">

    <!-- Premium Header Area -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2E7D32"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:elevation="4dp">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tablayout_tambon"
            style="@style/MyCustomTabLayoutDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/btn_close_tambon"
            android:background="@android:color/transparent"
            app:tabIndicatorColor="#FFD600"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="3dp"
            app:tabSelectedTextColor="#FFFFFF"
            app:tabTextColor="#B0BEC5"
            app:tabRippleColor="@null"
            app:tabGravity="fill"
            app:tabMode="fixed" />

        <ImageButton
            android:id="@+id/btn_close_tambon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close_vector"
            app:tint="#FFFFFF" />

    </RelativeLayout>

    <!-- Content Area -->
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/pager_layout_master"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never" />

</LinearLayout>