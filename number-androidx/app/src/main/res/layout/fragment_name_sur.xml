                                android:layout_height="wrap_content"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/txtTitleSortShaName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_marginTop="6dp"
                                    android:fontFamily="@font/browa_0"
                                    android:padding="6dp"
                                    android:text="เงาชื่อ :"
                                    android:textSize="@dimen/sizefontsat"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtSortShaName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:layout_toEndOf="@id/txtTitleSortShaName"
                                    android:fontFamily="@font/browa_0"
                                    android:padding="6dp"
                                    android:text="-"
                                    android:textSize="@dimen/sizefontsat"
                                    android:textStyle="bold" />


                            </RelativeLayout>

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/txtTitleSortShaSurName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="@font/browa_0"
                                    android:padding="6dp"
                                    android:text="เงานามสกุล : "
                                    android:textSize="@dimen/sizefontsat"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtSortShaSurName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_toEndOf="@id/txtTitleSortShaSurName"
                                    android:fontFamily="@font/browa_0"
                                    android:padding="6dp"
                                    android:text="-"
                                    android:textSize="@dimen/sizefontsat"
                                    android:textStyle="bold" />


                            </RelativeLayout>


                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/txtTitleSortShaNickName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="@font/browa_0"
                                    android:padding="6dp"
                                    android:text="เงาชื่อเล่น : "
                                    android:textSize="@dimen/sizefontsat"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtSortShaSurNickName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_toEndOf="@id/txtTitleSortShaNickName"
                                    android:fontFamily="@font/browa_0"
                                    android:padding="6dp"
                                    android:text="-"
                                    android:textSize="@dimen/sizefontsat"
                                    android:textStyle="bold" />


                            </RelativeLayout>


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:layout_marginTop="3dp"
                                android:orientation="horizontal">

                                <TextView

                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/browa_0"
                                    android:text="ชื่อ : "
                                    android:textSize="25sp" />

                                <TextView
                                    android:id="@+id/txtShaName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/browa_0"
                                    android:text="@{nameSurObs.pairSumShaName}"
                                    android:textSize="25sp"
                                    android:textStyle="bold"
                                    tools:text="ชื่อ" />


                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">

                                <TextView
                                    android:layout_gravity="end"
                                    android:layout_marginEnd="9dp"
                                    android:id="@+id/txtAyuntananame"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/browa_0"
                                    android:text="@{nameSurObs.ayantanaName}"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    tools:text="อายตนะ" />

                                </FrameLayout>
                            </LinearLayout>


                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="3dp"
                                android:layout_marginEnd="3dp"

                                android:background="@android:color/darker_gray" />


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:layout_marginTop="3dp"
                                android:orientation="horizontal">

                                <TextView

                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/browa_0"
                                    android:text="สกุล : "
                                    android:textSize="25sp" />


                                <TextView
                                    android:id="@+id/txtShaSurName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/browa_0"
                                    android:text="@{nameSurObs.pairSumShaSurname}"
                                    android:textSize="25sp"
                                    android:textStyle="bold"
                                    tools:text="สกุล" />

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">

                                    <TextView
                                        android:layout_gravity="end"
                                        android:layout_marginEnd="9dp"
                                        android:id="@+id/txtAyuntanaSurname"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/browa_0"
                                        android:text="@{nameSurObs.ayantanaSurName}"
                                        android:textSize="24sp"
                                        android:textStyle="bold"
                                        tools:text="อายตนะ" />

                                </FrameLayout>


                            </LinearLayout>


                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="3dp"
                                android:layout_marginEnd="3dp"

                                android:background="@android:color/darker_gray" />


                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#E4E3E2">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">




                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="9dp"
                                    android:layout_marginTop="3dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:textStyle="bold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="2dp"
                                        android:fontFamily="@font/browa_0"
                                        android:text="สรุป : "
                                        android:textColor="#3C3434"
                                        android:textSize="25sp" />


                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">


                                        <TextView
                                            android:id="@+id/txtSumShaNameSurName"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginBottom="2dp"
                                            android:fontFamily="@font/browa_0"
                                            android:text="@{nameSurObs.pairSumShaNameSurname}"
                                            android:textColor="#3C3434"
                                            android:textSize="25sp"
                                            android:textStyle="bold"
                                            tools:text="pairSumShaSurname" />


                                        <FrameLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content">

                                            <TextView
                                                android:layout_gravity="end"
                                                android:layout_marginEnd="9dp"
                                                android:id="@+id/txtAyuntanaNameSurname"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:fontFamily="@font/browa_0"
                                                android:text="@{nameSurObs.ayantanaNameSurname}"
                                                android:textSize="24sp"
                                                android:textStyle="bold"
                                                tools:text="อายตนะ" />

                                        </FrameLayout>

                                    </LinearLayout>
                                </LinearLayout>

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="1dp"
                                        android:layout_marginStart="3dp"
                                        android:layout_marginEnd="3dp"

                                        android:background="@android:color/darker_gray" />

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="1dp"
                                        android:layout_marginStart="3dp"
                                        android:layout_marginTop="1dp"
                                        android:layout_marginEnd="3dp"
                                        android:layout_marginBottom="9dp"
                                        android:background="@android:color/darker_gray" />
                                </LinearLayout>
                            </FrameLayout>


                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:id="@+id/linBtnBottom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">



                    </LinearLayout>


                        </LinearLayout>

                    </RelativeLayout>
                    <FrameLayout
                        android:id="@+id/fragment_ad_container_namesur_re"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                </LinearLayout>







                </RelativeLayout>
            </androidx.core.widget.NestedScrollView>



            <FrameLayout
                android:layout_width="wrap_content"

                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <ProgressBar
                    android:id="@+id/progressbar_namesur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal" />
            </FrameLayout>


        </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
