    <FrameLayout
        android:layout_marginBottom="9dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_news_phonenum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/btn_readmorenews"
            android:textColor="@color/txt_btn_readmorenews"
            android:text="อ่านบทความทั้งหมด"
            />


