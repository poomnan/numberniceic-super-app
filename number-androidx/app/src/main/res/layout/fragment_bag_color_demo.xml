<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="สีกระเป๋ามงคล"
            android:fontFamily="@font/kanit_light"
            android:textSize="28sp"
            android:textColor="#212121"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Age Range -->
        <TextView
            android:id="@+id/txt_age_range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="อายุ 43 ปี ยาง 44 ปี"
            android:fontFamily="@font/kanit_light"
            android:textSize="18sp"
            android:textColor="#757575"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            tools:text="อายุ 43 ปี ยาง 44 ปี" />

        <!-- Bag Color View -->
        <com.numberniceic.ui.bag.BagColorView
            android:id="@+id/bag_color_view"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginBottom="24dp" />

        <!-- Lucky Numbers -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="เลขนำโชค"
            android:fontFamily="@font/kanit_light"
            android:textSize="16sp"
            android:textColor="#2E7D32"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txt_lucky_numbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="41 09 42 59 97 23"
            android:fontFamily="@font/sarabun_regular"
            android:textSize="24sp"
            android:textColor="#212121"
            android:layout_marginBottom="24dp"
            tools:text="41 09 42 59 97 23" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="กรุณาติดต่อเปิดตรวจ\nประจำปีเพื่อทราบสี\nกระเป๋ามงคลของท่านใน\nปีนี้"
            android:fontFamily="@font/sarabun_regular"
            android:textSize="18sp"
            android:textColor="#E53935"
            android:lineHeight="32dp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Color Legend -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ความหมายของสี"
            android:fontFamily="@font/kanit_light"
            android:textSize="20sp"
            android:textColor="#212121"
            android:layout_marginBottom="16dp" />

        <!-- Color 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <View
                android:id="@+id/color_indicator_1"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#2E7D32" />

            <TextView
                android:id="@+id/txt_color_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="เขียว - โชคลาภ การเงิน"
                android:fontFamily="@font/sarabun_regular"
                android:textSize="16sp"
                android:textColor="#424242"
                tools:text="เขียว - โชคลาภ การเงิน" />
        </LinearLayout>

        <!-- Color 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <View
                android:id="@+id/color_indicator_2"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#1565C0" />

            <TextView
                android:id="@+id/txt_color_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="น้ำเงิน - สุขภาพ ความสงบ"
                android:fontFamily="@font/sarabun_regular"
                android:textSize="16sp"
                android:textColor="#424242"
                tools:text="น้ำเงิน - สุขภาพ ความสงบ" />
        </LinearLayout>

        <!-- Color 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <View
                android:id="@+id/color_indicator_3"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#EF6C00" />

            <TextView
                android:id="@+id/txt_color_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="ส้ม - ความรัก ความสัมพันธ์"
                android:fontFamily="@font/sarabun_regular"
                android:textSize="16sp"
                android:textColor="#424242"
                tools:text="ส้ม - ความรัก ความสัมพันธ์" />
        </LinearLayout>

        <!-- Color 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <View
                android:id="@+id/color_indicator_4"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#5D4037" />

            <TextView
                android:id="@+id/txt_color_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="น้ำตาล - เสถียรภาพ ความมั่นคง"
                android:fontFamily="@font/sarabun_regular"
                android:textSize="16sp"
                android:textColor="#424242"
                tools:text="น้ำตาล - เสถียรภาพ ความมั่นคง" />
        </LinearLayout>

        <!-- Test Buttons (for demo) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ทดสอบเปลี่ยนสี"
            android:fontFamily="@font/kanit_light"
            android:textSize="18sp"
            android:textColor="#212121"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_test_colors_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ชุดสีที่ 1 (เขียว-น้ำเงิน-ส้ม-น้ำตาล)"
            android:fontFamily="@font/sarabun_regular"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_test_colors_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ชุดสีที่ 2 (แดง-ทอง-ม่วง-ชมพู)"
            android:fontFamily="@font/sarabun_regular"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_test_colors_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ชุดสีที่ 3 (ดำ-ขาว-เทา-เงิน)"
            android:fontFamily="@font/sarabun_regular" />

    </LinearLayout>

</ScrollView>
