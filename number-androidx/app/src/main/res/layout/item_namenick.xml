<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/li_nick_vip"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">





        <TextView
            android:layout_weight="1"
            android:id="@+id/nicknameid"
            android:textSize="14sp"
            android:text="1"
            android:layout_marginStart="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


        <TextView
            android:id="@+id/thainame"
            android:textSize="18sp"
            android:paddingStart="10dp"
            android:text="นินท์"
            android:textColor="#1E88E5"
            android:textStyle="normal"
            android:textAlignment="gravity"
            android:layout_weight="0.99"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView

            android:id="@+id/leksat_thai"
            android:textSize="16sp"
            android:text="24"
            android:textStyle="bold"
            android:textColor="#43A047"
            android:layout_marginStart="40dp"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView

            android:id="@+id/shadow"
            android:textSize="16sp"
            android:text="45"
            android:textStyle="bold"
            android:textColor="#FB8C00"
            android:textAlignment="center"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


        <TextView

            android:id="@+id/reangthai"
            android:paddingStart="2dp"
            android:textSize="14sp"
            android:text="999999"
            android:textColor="#5F2A19"
            android:textAlignment="gravity"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


        <TextView

            android:id="@+id/engname"
            android:textSize="15sp"
            android:text="Nint"
            android:paddingStart="10dp"
            android:textColor="#3949AB"
            android:textAlignment="gravity"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


        <TextView

            android:id="@+id/leksat_eng"
            android:textSize="16sp"
            android:text="45"
            android:textStyle="bold"
            android:textColor="#43A047"
            android:textAlignment="center"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:visibility="gone"
            android:id="@+id/reangeng"
            android:paddingStart="5dp"
            android:textSize="14sp"
            android:textColor="#3E411C"
            android:text="999999"
            android:textAlignment="gravity"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />




        <TextView
            android:visibility="gone"
            android:id="@+id/sex"
            android:textSize="15sp"
            android:text="หญิง"
            android:textAlignment="center"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


    </LinearLayout>

