<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:layout_marginTop="50dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F9FCF9"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_d"
            android:layout_width="30dp"
            android:layout_height="45dp"
            android:layout_marginStart="9dp"
            android:src="@drawable/icon_luckycat24"
            tools:src="@drawable/icon_luckycat24" />

        <TextView
            android:id="@+id/txt_report_d"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"

            android:layout_gravity="center_vertical"
            android:text="เบอร์โทรศัพท์มงคล VIP"
            android:textColor="#3fa33f"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="เบอร์โทรศัพท์มงคล VIP" />

    </LinearLayout>
</LinearLayout>
