<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="homeObs"
            type="com.numberniceic.ui.home.HomeObs" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EEEEEE">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            tools:context=".ui.home.HomeF">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#EEEEEE">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#B841CC"
                        android:orientation="vertical">


                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="8dp"
                            android:layout_marginBottom="8dp"
                            app:cardBackgroundColor="#B841CC"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="4dp">

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="3dp"
                                app:cardBackgroundColor="#FFFFFF"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:hintEnabled="false"
                                    app:endIconMode="clear_text"
                                    app:boxBackgroundMode="none">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/edtHomeNum"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="0dp"
                                        android:digits="1234567890/"
                                        android:drawableStart="@drawable/icon_home02"
                                        android:gravity="center_horizontal"
                                        android:hint="บ้านเลขที่"
                                        android:inputType="text"
                                        android:maxLines="1"
                                        android:paddingTop="20dp"
                                        android:paddingBottom="10dp"
                                        android:singleLine="true"
                                        android:textSize="36sp"
                                        android:textStyle="bold"
                                        android:background="@null" />

                                </com.google.android.material.textfield.TextInputLayout>
                            </androidx.cardview.widget.CardView>
                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:id="@+id/linBottom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="0dp"
                            android:layout_marginBottom="0dp"
                            android:orientation="horizontal">


                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnHomeClear"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ล้าง"

                                app:backgroundTint="#B841CC"
                                app:cornerRadius="9dp"
                                app:icon="@drawable/ic_stop_48"
                                app:iconSize="24dp" />


                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnHomeMiracle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:text="ผลทำนาย"
                                app:backgroundTint="#B841CC"
                                app:cornerRadius="9dp"
                                app:icon="@drawable/ic_eye_48"
                                app:iconSize="24dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnHomeCal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:text="ถอดรหัส"
                                app:backgroundTint="#B841CC"
                                app:cornerRadius="9dp"
                                app:icon="@drawable/ic_clover"
                                app:iconSize="24dp" />


                        </LinearLayout>

                    </LinearLayout>


                    <FrameLayout
                        android:id="@+id/fragment_ad_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">


                        <LinearLayout

                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#000000"
                                android:padding="4dp">

                                <TextView

                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="3dp"
                                    android:padding="3dp"
                                    android:text="สรุปผลดีร้ายของบ้านเลขที่นี้"
                                    android:textColor="#FAF19F"
                                    android:textSize="18sp" />

                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"

                                android:background="#FFF"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:padding="1dp">


                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="#f1efef"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/txtTitleRe"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical"
                                        android:layout_weight="4"

                                        android:fontFamily="@font/sarun"

                                        android:gravity="center_horizontal"
                                        android:text="เลขหลัก :"
                                        android:textColor="#3b3a3a"
                                        android:textSize="18sp" />


                                    <androidx.recyclerview.widget.RecyclerView
                                        android:id="@+id/recyclePairsHome"

                                        android:layout_width="match_parent"
                                        android:layout_height="60dp"
                                        android:layout_weight="1" />

                                    <TextView
                                        android:id="@+id/txtCountConA"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1.3"
                                        android:fontFamily="@font/sarun"
                                        android:gravity="center"
                                        android:text="@{homeObs.percentPairsA}"
                                        android:textColor="#3b3a3a"
                                        android:textSize="18sp"
                                        android:visibility="gone"
                                        tools:text="x?" />
                                </LinearLayout>


                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="horizontal">


                                    <TextView
                                        android:id="@+id/txtTitleReB"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical"
                                        android:layout_weight="4"
                                        android:fontFamily="@font/sarun"
                                        android:gravity="center_horizontal"
                                        android:text="เลขแฝง :"
                                        android:textColor="#3b3a3a"
                                        android:textSize="18sp" />


                                    <androidx.recyclerview.widget.RecyclerView
                                        android:id="@+id/recyclePairsHomeB"
                                        android:layout_width="match_parent"
                                        android:layout_height="60dp"
                                        android:layout_weight="1"
                                        android:padding="3dp" />

                                    <TextView
                                        android:id="@+id/txtCountConB"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1.3"
                                        android:fontFamily="@font/sarun"
                                        android:gravity="center"
                                        android:text="@{homeObs.percentPairsB}"
                                        android:textColor="#3b3a3a"
                                        android:textSize="18sp"
                                        android:visibility="gone"
                                        tools:text="x?" />
                                </LinearLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#FFF"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="0.5dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="#ed9f21"
                                        android:padding="5dp"
                                        android:gravity="center_horizontal"
                                        android:text="เลขเรียง"
                                        android:textColor="#FFF"
                                        android:textSize="@dimen/titlebox" />

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="44dp"
                                        android:gravity="center"
                                        android:background="#F8F7F7"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/txtHomeNumber"
                                            android:layout_width="wrap_content"

                                            android:layout_height="wrap_content"

                                            android:text="@{homeObs.homeId}"
                                            android:textColor="#f28601"
                                            android:textSize="@dimen/headbox"
                                            android:textStyle="bold"
                                            tools:text="-" />

                                        <com.google.android.material.chip.Chip
                                            android:id="@+id/chipReportRrang"
                                            android:layout_width="wrap_content"
                                            android:layout_height="match_parent"
                                         android:layout_marginStart="10dp"
                                            app:chipBackgroundColor="#F6F7F2"
                                            android:text="@{homeObs.gradeNumReang}"
                                            android:textColor="#f28601"
                                            android:textSize="@dimen/headbox"
                                            android:textStyle="bold"
                                            tools:text="ดีเยี่ยม" />
                                    </LinearLayout>


                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="0.5dp"
                                    android:layout_weight="1"

                                    android:orientation="vertical">

                                    <TextView
                                        android:padding="5dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="#41b358"
                                        android:gravity="center_horizontal"
                                        android:text="ผลรวม"
                                        android:textColor="#FFF"
                                        android:textSize="@dimen/titlebox" />



                                    <LinearLayout
                                        android:orientation="horizontal"
                                        android:layout_width="match_parent"
                                        android:layout_height="44dp"
                                        android:gravity="center"
                                        android:background="#F8F7F7">

                                        <androidx.cardview.widget.CardView
                                            android:layout_width="36dp"
                                            android:layout_height="36dp"
                                            android:layout_gravity="center"
                                            app:cardBackgroundColor="@{homeObs.bgPairSumNumber==1?@color/colorPairD:homeObs.bgPairSumNumber==0?@color/colorPairR:@color/colorBGWhite}"
                                            app:cardCornerRadius="18dp"

                                            tools:cardBackgroundColor="#FDD835">

                                            <TextView
                                                android:id="@+id/txtCirclePairSumHome"
                                                android:layout_width="36dp"
                                                android:layout_height="36dp"
                                                android:gravity="center"
                                                android:text="@{homeObs.pairSumNumber}"
                                                android:textColor="@{homeObs.bgPairSumNumber==0 || homeObs.bgPairSumNumber==1 ? @color/colorTextPair : @color/colorPairR}"
                                                android:textSize="@dimen/circurPair"
                                                android:textStyle="bold"
                                                tools:text="0" />
                                        </androidx.cardview.widget.CardView>

                                        <com.google.android.material.chip.Chip
                                            android:id="@+id/chipReportSum"
                                            android:layout_width="wrap_content"
                                            android:layout_height="match_parent"
                                            app:chipBackgroundColor="#FFF6F7F2"
                                            android:layout_gravity="center"
                                            android:layout_margin="2dp"
                                            android:text="@{homeObs.pairGradeSum}"
                                            android:textColor="#f28601"
                                            android:textSize="@dimen/headbox"
                                            android:textStyle="bold"
                                            tools:text="ดีเยี่ยม" />

                                    </LinearLayout>










                                </LinearLayout>


                            </LinearLayout>


                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#BEBBBB"
                                android:padding="4dp">


                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#FFF"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="0.5dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:padding="5dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="#3a9900"
                                        android:gravity="center_horizontal"
                                        android:text="คะแนนดี"
                                        android:textColor="#FFF"
                                        android:textSize="@dimen/titlebox" />

                                    <TextView
                                        android:id="@+id/txtTotalHomeScoreD"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="#FFFFFF"
                                        android:freezesText="true"

                                        android:gravity="center_horizontal"
                                        android:padding="4dp"
                                        android:text="@{homeObs.scoreD}"
                                        android:textColor="#1ca90e"
                                        android:textSize="@dimen/headbox"
                                        android:textStyle="bold"
                                        tools:text="0" />

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="0.5dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:padding="5dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="#B43C0B"
                                        android:gravity="center_horizontal"
                                        android:text="คะแนนร้าย"
                                        android:textColor="#FFF"
                                        android:textSize="@dimen/titlebox" />

                                    <TextView
                                        android:id="@+id/txtTotalHomeScoreR"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="#FFFFFF"
                                        android:gravity="center_horizontal"
                                        android:padding="4dp"
                                        android:text="@{homeObs.scoreR}"
                                        android:textColor="#FFFF0004"
                                        android:textSize="@dimen/headbox"
                                        android:textStyle="bold"
                                        tools:text="0" />
                                </LinearLayout>


                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#F7F4F4"
                                android:orientation="vertical"
                                android:padding="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="2dp"
                                    android:background="#Ffffff"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:id="@+id/img_report_d"
                                        android:layout_width="45dp"
                                        android:layout_height="45dp"
                                        android:layout_gravity="center_vertical"
                                        android:layout_marginStart="2dp"
                                        android:layout_weight="1"
                                        android:src="@drawable/ic_clover"
                                        tools:src="@drawable/ic_clover" />

                                    <TextView
                                        android:id="@+id/txt_report_d"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="3dp"
                                        android:layout_weight="8"
                                        android:text="@{homeObs.miracleD}"
                                        android:textColor="#3fa33f"
                                        android:textSize="16sp"
                                        tools:text="m text" />


                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="2dp"
                                    android:background="#Ffffff"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="45dp"
                                        android:layout_height="45dp"
                                        android:layout_weight="0"

                                        android:src="@drawable/ic_evil03"
                                        tools:src="@drawable/ic_evil03" />

                                    <TextView
                                        android:id="@+id/txt_report_r"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="3dp"
                                        android:layout_weight="1"
                                        android:text="@{homeObs.miracleR}"

                                        android:textColor="#E70202"
                                        android:textSize="16sp"
                                        tools:text="m text" />


                                </LinearLayout>

                            </LinearLayout>


                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#515151">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerHorizontal="true"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginBottom="2dp"
                                    android:padding="2dp"
                                    android:text="เพื่อความแม่นยำสูงสุดควรดูร่วมกับคำพยากรณ์อื่นๆ"
                                    android:textColor="#FFFFFF"
                                    android:textSize="16sp" />

                            </RelativeLayout>


                        </LinearLayout>


                    </FrameLayout>


                    <FrameLayout
                        android:id="@+id/fragment_ad_container_re"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />


                </LinearLayout>


            </androidx.core.widget.NestedScrollView>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <ProgressBar
                    android:id="@+id/progressbar_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </FrameLayout>


        </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>
