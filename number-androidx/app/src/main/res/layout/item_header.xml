<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lin_summery"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:background="#f1efef"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000">

        <TextView
            android:id="@+id/txtTitleSalum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:padding="3dp"
            android:text="สรุปผลดีร้ายของเบอร์นี้"
            android:textColor="#FAF19F"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/txtTitleTelephone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_toEndOf="@+id/txtTitleSalum"
            android:padding="3dp"
            android:textColor="#FAF19F"
            android:textSize="18sp"
            tools:text=" 0955456424" />

    </RelativeLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:background="#FFFFFF"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_d"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:src="@drawable/ic_clover"
            tools:src="@drawable/ic_clover" />

        <TextView
            android:id="@+id/txt_report_d"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="8"
            android:textColor="#3fa33f"
            android:textSize="16sp"
            tools:text="m text" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:background="#ffffff"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_r"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_weight="0"
            android:src="@drawable/ic_vip"
            tools:src="@drawable/ic_vip" />

        <TextView
            android:id="@+id/txt_report_r"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:textColor="#E70202"
            android:textSize="16sp"
            tools:text="m text" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">



        </RelativeLayout>

    </LinearLayout>

</LinearLayout>
