<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRe"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_margin="3dp"
    app:cardElevation="10dp">


    <com.battleent.ribbonviews.RibbonLayout
        android:id="@+id/ribbon_specialx"
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        app:bottom_height="100"

        app:bottom_padding="11"
        app:bottom_ribbonColor="@color/pale_magenta_90"
        app:bottom_text="Updated today"
        app:bottom_textColor="@android:color/white"
        app:bottom_textSize="18"
        app:header_padding="9"

        app:header_ribbonColor="@color/color_test_r10"
        app:header_ribbonRadius="6"

        app:header_text=""
        app:header_textColor="@android:color/white"
        app:header_textSize="16"
        app:show_bottom="false"
        app:show_header="true">

        <RelativeLayout
            android:id="@+id/linHeaderSpecialX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2d2d2d"
            android:paddingStart="15dp"
            android:paddingTop="36dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">


            <TextView
                android:id="@+id/txtPairSpecialXTitle"
                android:fontFamily="@font/browa_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="มหาวิทยาลัยอุบลราชธานี"
                android:textColor="#FFF"
                android:textSize="20sp"
                />


        </RelativeLayout>

    </com.battleent.ribbonviews.RibbonLayout>


</androidx.cardview.widget.CardView>

