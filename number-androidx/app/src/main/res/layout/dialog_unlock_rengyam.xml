<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="18dp">

    <TextView
        android:id="@+id/txt_unlock_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ปลดล็อกดูฤกษ์ยาม"
        android:textColor="#222222"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="@font/sarabun_semibold"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/txt_unlock_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="ปรับสถานะเป็น VIPLD เพื่อดูฤกษ์ดีฤกษ์เศรษฐีสำหรับคุณซึ่งดูได้ตลอดชีวิต ปรับสถานะ 5,999 บาท จากนั้นถ้าอยากให้เจาะเวลาดีให้มีค่าครู 100 บาทต่อครั้งเท่านั้น"
        android:textColor="#4A4A4A"
        android:textSize="16sp"
        android:fontFamily="@font/sarabun_regular"
        android:includeFontPadding="false"
        android:lineSpacingExtra="1dp" />

    <EditText
        android:id="@+id/edt_unlock_secret_code"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_ninin_secret_code_input"
        android:hint="กรอก VIP CODE ดูฤกษ์ยาม"
        android:textColorHint="#8A8A8A"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#1A1A1A"
        android:textSize="18sp"
        android:fontFamily="@font/sarabun_regular" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_unlock_chat_ninin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="คุยกับคุณนิน"
            android:textAllCaps="false"
            android:textColor="#2E7D32"
            android:textSize="16sp"
            android:fontFamily="@font/sarabun_semibold"
            android:includeFontPadding="true"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            app:backgroundTint="#E9F5EA"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_unlock_submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginStart="10dp"
            android:text="ปลดล็อก"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/sarabun_semibold"
            android:includeFontPadding="true"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            app:backgroundTint="@color/colorPrimary"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
