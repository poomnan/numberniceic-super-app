<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coor_admin_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.auth.UserLogoutAct">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E2E4E2"
            android:paddingBottom="100dp"
            android:orientation="vertical">

            <!-- กลุ่มที่ 1 'กลุ่มข้อความพิเศษ' -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="กลุ่มข้อความพิเศษ"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_secret_code"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:text="จัดการ Vipcode"
                    android:textSize="15sp"
                    android:backgroundTint="#2F660D"
                    app:icon="@drawable/list"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_personal_msg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:text="ข้อความพิเศษ"
                    android:textSize="15sp"
                    android:backgroundTint="#4CAF50"
                    app:icon="@drawable/notification"
                    app:iconSize="18dp" />
            </GridLayout>

            <!-- กลุ่ม 2 'กลุ่มแสดง VIP' -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="กลุ่มแสดง VIP"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_color_bag"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:text="สีกระเป๋าเงิน"
                    android:textSize="15sp"
                    android:backgroundTint="#CE6415"
                    app:icon="@drawable/sunsun"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_lucky_number"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:text="เลขนำโชค"
                    android:textSize="15sp"
                    android:backgroundTint="#D156EE"
                    app:icon="@drawable/light"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_buddha_pang_assign"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:text="ถวายพระ"
                    android:textSize="15sp"
                    android:backgroundTint="#AA7E12"
                    app:icon="@drawable/buddha"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sacred_temple_assign"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:text="วัดศักดิ์สิทธิ์"
                    android:textSize="15sp"
                    android:backgroundTint="#8D6E63"
                    app:icon="@drawable/tambon"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_spell_assign"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:text="คาถาพิเศษ"
                    android:textSize="15sp"
                    android:backgroundTint="#00897B"
                    app:icon="@drawable/lotus"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_inauspicious_assign"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:text="วันอัปมงคล"
                    android:textSize="15sp"
                    android:backgroundTint="#C62828"
                    app:icon="@drawable/delete"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_auspicious_assign"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:text="วันมงคล"
                    android:textSize="15sp"
                    android:backgroundTint="#388E3C"
                    app:icon="@drawable/ic_clover"
                    app:iconSize="18dp" />

            </GridLayout>

            <!-- กลุ่มที่ 3 'กลุ่มวิธีการ' -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="กลุ่มวิธีการ"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_merit_assign"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:text="วิธีการทำบุญ"
                    android:textSize="15sp"
                    android:backgroundTint="#FFD600"
                    android:textColor="#333333"
                    app:icon="@drawable/buddha"
                    app:iconTint="#333333"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_changenum_assign"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:text="ขั้นตอนเปลี่ยน"
                    android:textSize="15sp"
                    android:backgroundTint="#00ACC1"
                    app:icon="@drawable/list"
                    app:iconSize="18dp" />
            </GridLayout>

            <!-- กลุ่มที่ 4 'กลุ่มสินค้า' -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="กลุ่มสินค้า"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tabian_manage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:text="จัดการทะเบียน"
                    android:textSize="15sp"
                    android:backgroundTint="#283593"
                    app:icon="@drawable/car"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_category_manage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:text="ประเภทสินค้า"
                    android:textSize="15sp"
                    android:backgroundTint="#2E7D32"
                    app:icon="@drawable/list"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_product_manage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:text="จัดการสินค้า"
                    android:textSize="15sp"
                    android:backgroundTint="#388E3C"
                    app:icon="@drawable/ic_cart_white"
                    app:iconSize="18dp" />
                    
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_zircon_orders"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:text="ออเดอร์เพทาย"
                    android:textSize="15sp"
                    android:backgroundTint="#4A148C"
                    app:icon="@drawable/list"
                    app:iconSize="18dp" />

            </GridLayout>

            <!-- กลุ่มที่ 5 'จัดการข้อมูล' -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="จัดการข้อมูล"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_admin_chat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:text="แชทซัพพอร์ต"
                    android:textSize="15sp"
                    android:backgroundTint="#004D40"
                    app:icon="@drawable/article"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_dream"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:text="เติมฝัน"
                    android:textSize="15sp"
                    android:backgroundTint="#6A1B9A"
                    app:icon="@drawable/ic_dream"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_change_vip_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:text="สถานะสมาชิก"
                    android:textSize="15sp"
                    android:backgroundTint="#FF5722"
                    app:icon="@drawable/list"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_guest_address_manage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:text="ที่จัดส่ง Guest"
                    android:textSize="15sp"
                    android:backgroundTint="#FF9800"
                    app:icon="@android:drawable/ic_menu_mylocation"
                    app:iconSize="18dp"
                    app:iconTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_manual_palette_manage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:text="ตั้งค่าสีเสื้อผ้าที่ใส่"
                    android:textSize="15sp"
                    android:backgroundTint="#00796B"
                    app:icon="@drawable/spectrum"
                    app:iconSize="18dp"
                    app:iconTint="@null" />
            </GridLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_marginTop="9dp"
                android:layout_marginEnd="9dp"
                android:layout_marginBottom="9dp"
                app:cardBackgroundColor="#FFF"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="15dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="คุณคือคุณนิน ยิ้มๆยิ้มสิ จงทำวันนี้ให้ดีที่สุด มีความสุขซะ ขอให้ทุกๆวันนับจากนี้จงมีแต่เรื่องดีๆ ขอให้คุณนินมีความสุขกับสิ่งที่คิด พูด ทำตลอดน๊า รักนะ"
                        android:textColor="#43A047"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="horizontal">
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="9dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFF"
                app:cardCornerRadius="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="15dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/img_member_admin"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginBottom="16dp"
                        android:padding="2dp"
                        app:strokeWidth="3dp"
                        app:strokeColor="#FF0000"
                        app:shapeAppearanceOverlay="@style/CircleAvatar"
                        tools:src="@drawable/ic_avatar_10" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_user_edit_profile"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="แก้ไขข้อมูล"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:elevation="4dp"
                            android:fontFamily="sans-serif-medium"
                            app:backgroundTint="#FF9800"
                            app:cornerRadius="28dp"
                            app:rippleColor="#80FFE0B2"
                            app:strokeWidth="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_user_logout_admin"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="ออกจากระบบ"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:elevation="4dp"
                            android:fontFamily="sans-serif-medium"
                            app:backgroundTint="#D32F2F"
                            app:cornerRadius="28dp"
                            app:rippleColor="#FFFF8A80"
                            app:strokeWidth="0dp" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
