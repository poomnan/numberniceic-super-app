<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000">

        <TextView
            android:id="@+id/txtTitleSalum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:padding="3dp"
            android:text="สรุปผลดีร้ายของบ้านเลขที่นี้"
            android:textColor="#FAF19F"
            android:textSize="18sp" />

    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="0.5dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#3a9900"
                android:gravity="center_horizontal"
                android:text="คะแนนดี"
                android:padding="3dp"
                android:textColor="#FFF"
                android:textSize="@dimen/titlebox" />

            <TextView
                android:id="@+id/txt_score_header_home_d"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E2E0E0"
                android:freezesText="true"

                android:gravity="center_horizontal"
                android:padding="4dp"

                android:textColor="#1ca90e"
                android:textSize="@dimen/headbox"
                android:textStyle="bold"
                tools:text="0" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="0.5dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#B43C0B"
                android:padding="3dp"
                android:gravity="center_horizontal"
                android:text="คะแนนร้าย"
                android:textColor="#FFF"
                android:textSize="@dimen/titlebox" />

            <TextView
                android:id="@+id/txt_score_header_home_r"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E2E0E0"
                android:gravity="center_horizontal"
                android:padding="4dp"

                android:textColor="#FFFF0004"
                android:textSize="@dimen/headbox"
                android:textStyle="bold"
                tools:text="0" />
        </LinearLayout>


    </LinearLayout>
    <LinearLayout
        android:padding="1dp"
        android:background="#F7F4F4"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:background="#Ffffff"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_report_d"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:src="@drawable/ic_clover"
                tools:src="@drawable/ic_clover" />

            <TextView
                android:id="@+id/txt_report_header_home_d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="8"

                android:textColor="#3fa33f"
                android:textSize="16sp"
                tools:text="m text" />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:background="#Ffffff"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_weight="0"

                android:src="@drawable/ic_evil03"
                tools:src="@drawable/ic_evil03" />

            <TextView
                android:id="@+id/txt_report_header_home_r"

                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"

                android:textColor="#E70202"
                android:textSize="16sp"
                tools:text="m text" />


        </LinearLayout>

    </LinearLayout>


</LinearLayout>