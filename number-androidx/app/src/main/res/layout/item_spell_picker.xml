<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/img_spell_thumb"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:src="@drawable/lotus_placeholder"
            android:background="#EEE"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/txt_spell_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txt_spell_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description line 1\nDescription line 2"
                android:textSize="14sp"
                android:textColor="#757575"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="4dp" />
            
            <TextView
                android:id="@+id/txt_spell_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Admin Note"
                android:textSize="12sp"
                android:textColor="#E65100"
                android:textStyle="italic"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_spell_view"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:text="เปิดดู"
                android:textSize="12sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:backgroundTint="#0288D1"
                android:textColor="#FFF"
                android:minWidth="60dp"
                android:padding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_spell_send"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:layout_marginTop="4dp"
                android:text="ส่ง"
                android:textSize="12sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:backgroundTint="#00897B"
                android:textColor="#FFF"
                android:minWidth="60dp"
                android:padding="0dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
