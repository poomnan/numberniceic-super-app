    <ImageView
        android:id="@+id/img_member_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:src="@drawable/icon_member"
        android:contentDescription="Member" />

</FrameLayout>
