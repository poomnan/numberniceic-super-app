<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_dark_green"
    android:padding="0dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="#B8DFCA" />

    <!-- Title & Icon Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_auspicious_section_header_green"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp">
        
        <ImageView
            android:id="@+id/img_bottom_sheet_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/valentines_day"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_bottom_sheet_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sarabun_semibold"
                android:text="รายการวันมงคล [ชื่อสมาชิก]"
                android:textColor="#1F4F3B"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_edit_marriage_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_white_rounded_with_stroke"
                android:fontFamily="@font/sarabun_semibold"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:text="กลับหน้าข้อมูลบ่าวสาว"
                android:textColor="#2E7D32"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <!-- List Content Card -->
    <LinearLayout
        android:id="@+id/layout_auspicious_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_auspicious_section_table_green"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="24dp"
        android:paddingHorizontal="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/txt_marriage_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="#E8F5E9"
            android:padding="12dp"
            android:textSize="13sp"
            android:textColor="#2E7D32"
            android:fontFamily="@font/sarabun_regular"
            android:lineSpacingMultiplier="1.2"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="หมายเหตุการหาฤกษ์..."/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_auspicious_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="600dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            tools:listitem="@layout/item_wanpra_value" />
    </LinearLayout>

</LinearLayout>
