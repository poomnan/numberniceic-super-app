<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:context=".ui.admin.SecretCopf">

    <LinearLayout
        android:gravity="center"
        android:padding="9dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:textSize="18sp"
            android:text="ทำการบันทึกข้อมูลเรียบร้อยแล้ว!"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txt_codename_copy"
            android:textColor="#304FFE"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="9dp"
            android:text="xxxxx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:textSize="18sp"
            android:layout_marginBottom="9dp"
            android:text="ต้องการ Copy หรือไม่?"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />


        <LinearLayout
            android:layout_marginBottom="9dp"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:textSize="18sp"
                android:id="@+id/btn_secretcode_cancel"
                android:backgroundTint="#C4C2C2"
                android:text="ไม่ ขอบคุณ"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:textSize="18sp"
                android:id="@+id/btn_secretcode_copy"
                android:layout_marginStart="9dp"
                android:backgroundTint="#00C853"
                android:text="copy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>



    </LinearLayout>



</RelativeLayout>