<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_wanpra_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Best Day Background Highlight -->
    <View
        android:id="@+id/bg_best_day"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#19FFD700"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/card_wanpra_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:minHeight="58dp">

            <!-- Left Container: Date & Other Notes -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3.2"
                android:orientation="vertical"
                android:layout_gravity="center_vertical">
                
                <TextView
                    android:id="@+id/txt_date_wanpra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/sarabun_semibold"
                    android:textColor="#213547"
                    tools:text="ศุกร์ 6 มีนาคม 2569"/>
                
                <TextView
                    android:id="@+id/txt_extra_note"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    tools:visibility="gone"/>
            </LinearLayout>

            <!-- Right Container: Status Badges (วันพระ, ธงชัย, อธิบดี, etc.) -->
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/flex_badges"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.8"
                android:layout_marginStart="12dp"
                android:minHeight="34dp"
                app:flexWrap="wrap"
                app:justifyContent="flex_end"
                app:alignItems="flex_end"
                android:layout_gravity="center_vertical">

                <TextView
                    android:id="@+id/badge_pra"
                    style="@style/AuspiciousBadge"
                    android:background="@drawable/bg_orange_rounded"
                    android:layout_margin="2dp"
                    android:text="วันพระ"
                    android:visibility="gone"
                    tools:visibility="visible"/>

                <TextView
                    android:id="@+id/badge_tongchai"
                    style="@style/AuspiciousBadge"
                    android:background="@drawable/bg_green_pill"
                    android:layout_margin="2dp"
                    android:text="ธงชัย"
                    android:visibility="gone"
                    tools:visibility="visible"/>

                <TextView
                    android:id="@+id/badge_atipbadee"
                    style="@style/AuspiciousBadge"
                    android:background="@drawable/bg_blue_rounded"
                    android:layout_margin="2dp"
                    android:text="อธิบดี"
                    android:visibility="gone"
                    tools:visibility="visible"/>
                    
                <TextView
                    android:id="@+id/badge_lokawinat"
                    style="@style/AuspiciousBadge"
                    android:background="@drawable/bg_red_pill"
                    android:layout_margin="2dp"
                    android:text="โลกาวินาศ"
                    android:visibility="gone"
                    tools:visibility="visible"/>
                    
                <TextView
                    android:id="@+id/badge_ubath"
                    style="@style/AuspiciousBadge"
                    android:background="@drawable/bg_red_pill"
                    android:layout_margin="2dp"
                    android:text="อุบาทว์"
                    android:visibility="gone"
                    tools:visibility="visible"/>
                    
                <!-- Keep other badges just in case but hide them unless relevant -->
                <TextView android:id="@+id/badge_sittichok" style="@style/AuspiciousBadge" android:text="สิทธิโชค" android:background="@drawable/bg_blue_rounded" android:layout_margin="2dp" android:visibility="gone" />
                <TextView android:id="@+id/badge_ammarit" style="@style/AuspiciousBadge" android:text="อมฤตโชค" android:background="@drawable/bg_green_pill" android:layout_margin="2dp" android:visibility="gone" />
                <TextView android:id="@+id/badge_mahasitti" style="@style/AuspiciousBadge" android:text="มหาสิทธิโชค" android:background="@drawable/bg_green_pill" android:layout_margin="2dp" android:visibility="gone" />
                <TextView android:id="@+id/badge_racha" style="@style/AuspiciousBadge" android:text="ราชาโชค" android:background="@drawable/bg_blue_rounded" android:layout_margin="2dp" android:visibility="gone" />
                <TextView android:id="@+id/badge_chaichok" style="@style/AuspiciousBadge" android:text="ชัยโชค" android:background="@drawable/bg_blue_rounded" android:layout_margin="2dp" android:visibility="gone" />
                <TextView android:id="@+id/badge_fu" style="@style/AuspiciousBadge" android:text="วันฟู" android:background="@drawable/bg_blue_rounded" android:layout_margin="2dp" android:visibility="gone" />
                <TextView android:id="@+id/badge_loy" style="@style/AuspiciousBadge" android:text="วันลอย" android:background="@drawable/bg_blue_rounded" android:layout_margin="2dp" android:visibility="gone" />
                <TextView
                    android:id="@+id/badge_kalagni"
                    style="@style/AuspiciousBadge"
                    android:background="@drawable/bg_white_pill"
                    android:layout_margin="2dp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:textColor="#C62828"
                    tools:text="วันอัปมงคลวันเกิด" />
                    
                <TextView android:id="@+id/badge_riangmon" style="@style/AuspiciousBadge" android:text="เรียงหมอน" android:background="@drawable/bg_orange_rounded" android:layout_margin="2dp" android:visibility="gone" />

            </com.google.android.flexbox.FlexboxLayout>
        </LinearLayout>

        <!-- Minimal Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="2dp"
            android:background="#C9E1D1"
            android:alpha="0.9"/>

    </LinearLayout>

    <ImageView
        android:id="@+id/img_best_crown"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/crown"
        android:visibility="gone"
        tools:visibility="visible"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="0dp"
        android:layout_marginStart="4dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
