<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="16dp"
    android:background="#FFFFFF">

    <!-- Drag Handle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="#E0E0E0" />
    </LinearLayout>

    <!-- Header -->
    <TextView
        android:id="@+id/txt_header_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:text="การแจ้งเตือนจากคุณนิน"
        android:textSize="26sp"
        android:textColor="#056409"
        android:fontFamily="@font/kanit_light"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE" />

    <!-- List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_notifications"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"/>

    <!-- Footer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="ปัดซ้ายเพื่อลบรายการแจ้งเตือน"
        android:textSize="12sp"
        android:textColor="#9E9E9E"
        android:fontFamily="@font/kanit_light"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/ic_delete_vector"
        app:drawableTint="#9E9E9E" />

</LinearLayout>
