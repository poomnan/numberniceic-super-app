<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="topicObs"
            type="com.numberniceic.ui.admin.TopicObs" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            tools:context=".ui.admin.TopicF">

            <LinearLayout
                android:padding="3dp"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:text="รหัสบทความ : "
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/topic_id"
                    android:text="@{topicObs.topicId}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_marginStart="18dp"
                    android:text="เขียนเมื่อ : "
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:text="@{topicObs.topicDateTime}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:padding="3dp"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/topic_auth"
                    android:text="เขียนโดย : "
                    android:textSize="18sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:text="@{topicObs.authName}"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />


            </LinearLayout>



            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_margin="3dp"
                app:cardCornerRadius="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:textColor="#FFF"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F8D182"
                        android:padding="3dp"
                        android:text="ชื่อเรื่อง :"
                        android:textSize="18sp"
                        android:textStyle="italic|bold" />

                    <!--<View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:layout_marginBottom="3dp"
                        android:background="@android:color/darker_gray" />-->

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/edt_header_topic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:hint="Title"
                        android:text="@{topicObs.topicHeader}" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_margin="3dp"
                app:cardCornerRadius="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:textColor="#FFF"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F8D182"
                        android:padding="3dp"
                        android:text="คำอธิบายเรื่อง :"
                        android:textSize="18sp"
                        android:textStyle="italic|bold" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/edt_desc_topic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:hint="Description"
                        android:text="@{topicObs.topicDesc}" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:text="#เบอร์โทร"
                    app:chipBackgroundColor="@{topicObs.chipPhone}" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_car"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:text="#ทะเบียนรถ"
                    app:chipBackgroundColor="@{topicObs.chipTabian}" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_namesurname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:text="#ชื่อเล่น ชื่อสกุล"
                    app:chipBackgroundColor="@{topicObs.chipNameSur}" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:text="#บ้านเลขที่"
                    app:chipBackgroundColor="@{topicObs.chipHome}" />

            </LinearLayout>




            <ImageView
                android:layout_marginTop="9dp"
                android:id="@+id/img_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:src="@{topicObs.imgHeader}"
                tools:src="@drawable/image" />

            <TextView
                android:textColor="#FFF"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F8D182"
                android:padding="3dp"
                android:text="ย่อหน้าที่ 1 :"
                android:textSize="18sp"
                android:textStyle="italic|bold" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/edt_paragraph1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="paragraph1"
                android:text="@{topicObs.topicParagraph1}" />


            <ImageView
                android:layout_marginTop="18dp"
                android:id="@+id/img_paragraph1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:src="@{topicObs.imgParagraph1}"
                tools:src="@drawable/image" />

            <TextView
                android:textColor="#FFF"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F8D182"
                android:padding="3dp"
                android:text="ย่อหน้าที่ 2 :"
                android:textSize="18sp"
                android:textStyle="italic|bold" />



            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/edt_paragraph2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="paragraph2"
                android:text="@{topicObs.topicParagraph2}" />


            <ImageView
                android:layout_marginTop="18dp"
                android:id="@+id/img_paragraph2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:src="@{topicObs.imgParagraph2}"
                tools:src="@drawable/image" />


            <TextView
                android:textColor="#FFF"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F8D182"
                android:padding="3dp"
                android:text="ย่อหน้าที่ 3 :"
                android:textSize="18sp"
                android:textStyle="italic|bold" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/edt_paragraph3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="paragraph3"
                android:text="@{topicObs.topicParagraph3}" />


            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_marginStart="20dp"
                        android:text="* ยังไม่ SAVE"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                <com.google.android.material.button.MaterialButton
                    android:layout_marginStart="20dp"
                    android:id="@+id/btn_topic_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="save" />
                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_marginStart="20dp"
                        android:text="เผยแพรส"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                <androidx.appcompat.widget.SwitchCompat
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                </LinearLayout>


            </LinearLayout>



        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>