<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/view_color_preview"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/circle_color" />

            <TextView
                android:id="@+id/txt_color_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="สีแดงเลือดนก" />

            <TextView
                android:id="@+id/txt_hex_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#0277BD"
                android:textSize="14sp"
                tools:text="#8B0000" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_default_hex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#757575"
            android:textSize="12sp"
            tools:text="ค่าเริ่มต้น: #8B0000" />

        <TextView
            android:id="@+id/txt_day_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#455A64"
            android:textSize="12sp"
            tools:text="วันประจำชุดสี: อาทิตย์ (เลข 1)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_edit_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="แก้ไข"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_reset_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="รีเซ็ต"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
