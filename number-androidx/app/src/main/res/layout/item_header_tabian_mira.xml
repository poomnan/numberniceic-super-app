<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:tool="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000">

        <TextView
            android:id="@+id/txtTitleSalum2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:padding="3dp"
            android:text="สรุปผลดีร้ายของทะเบียนนี้"
            android:textColor="#FAF19F"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/txtTitleTabain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_toEndOf="@+id/txtTitleSalum2"
            android:padding="3dp"
            android:textColor="#FAF19F"
            android:textSize="18sp" />

    </RelativeLayout>

    <LinearLayout
       android:padding="0.5dp"
        android:background="#DDDDDD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_margin="0.5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#3a9900"
                        android:gravity="center_horizontal"
                        android:padding="0dp"
                        android:text="คะแนนดี"

                        android:textColor="#F8F7F7"
                        android:textSize="@dimen/titlebox" />

                    <TextView
                        android:id="@+id/txt_score_d"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:background="#F8F7F7"
                        android:gravity="center_horizontal"
                        android:padding="0dp"
                        android:textColor="#1ca90e"
                        android:textSize="@dimen/headbox"
                        android:textStyle="bold"
                        tools:text="0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_margin="0.5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#B43C0B"
                        android:gravity="center_horizontal"
                        android:padding="0dp"
                        android:text="คะแนนร้าย"
                        android:textColor="#FFF"
                        android:textSize="@dimen/titlebox" />

                    <TextView
                        android:id="@+id/txt_score_r"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:background="#FFFFFF"
                        android:gravity="center_horizontal"
                        android:textColor="#FFFF0004"
                        android:textSize="@dimen/headbox"
                        android:textStyle="bold"
                        tools:text="0" />
                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <LinearLayout
                    android:layout_margin="0.5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#3a9900"
                        android:gravity="center_horizontal"
                        android:text="% ดี"
                        android:textColor="#FFF"
                        android:textSize="@dimen/titlebox" />

                    <TextView
                        android:id="@+id/txt_percent_tabian_d"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFF"
                        android:gravity="center_horizontal"
                        android:textColor="#1ca90e"
                        android:textSize="@dimen/headbox"
                        android:textStyle="bold"
                        tools:text="0%" />
                </LinearLayout>

                <LinearLayout
                    android:layout_margin="0.5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#B43C0B"
                        android:gravity="center_horizontal"
                        android:text="% ร้าย"
                        android:textColor="#FFF"
                        android:textSize="@dimen/titlebox" />

                    <TextView
                        android:id="@+id/txt_percent_tabian_r"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFFFFF"
                        android:gravity="center_horizontal"
                        android:textColor="#ff0004"
                        android:textSize="@dimen/headbox"
                        android:textStyle="bold"
                        tools:text="0%" />
                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>




    <LinearLayout
        android:padding="1dp"
        android:background="#F7F4F4"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:background="#Ffffff"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_mira_report_d"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            tools:src="@drawable/ic_clover" />

        <TextView
            android:id="@+id/txt_mira_report_d"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="8"

            android:textColor="#3fa33f"
            android:textSize="16sp"
            tools:text="m text" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:background="#Ffffff"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_weight="0"
            android:src="@drawable/ic_evil03"
            tools:src="@drawable/ic_evil03" />

        <TextView
            android:id="@+id/txt_mira_report_r"

            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1"

            android:textColor="#E70202"
            android:textSize="16sp"
            tools:text="m text" />


    </LinearLayout>

    </LinearLayout>

</LinearLayout>
