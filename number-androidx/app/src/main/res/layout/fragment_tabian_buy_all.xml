<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.tabian.TabianBuyAllF">

    <androidx.core.widget.NestedScrollView
        android:layout_width="wrap_content"
        android:layout_height="match_parent">


<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:background="#FFFFFF"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="30dp"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:src="@drawable/ic_vip02"
            tools:src="@drawable/ic_vip02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="8"
            android:textStyle="bold"
            android:text="ทะเบียนรถมงคล VIP"
            android:textColor="#3fa33f"
            android:textSize="16sp"
            tools:text="ทะเบียนรถมงคล VIP" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:background="#ffffff"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_tabianbuy_top1"
                        android:layout_width="140dp"
                        android:layout_height="65dp"
                        android:layout_margin="5dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="4dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#000000"
                        app:strokeWidth="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_plate_buy_top1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4กธ 4245"
                                android:fontFamily="@font/sarun"
                                android:textColor="#000000"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="กรุงเทพมหานคร"
                                android:textColor="#000000"
                                android:textSize="12sp"
                                android:layout_marginTop="-5dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_tabianbuy_top1_2"
                        android:layout_width="140dp"
                        android:layout_height="65dp"
                        android:layout_margin="5dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="4dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#000000"
                        app:strokeWidth="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_plate_buy_top1_2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4กฮ 4145"
                                android:fontFamily="@font/sarun"
                                android:textColor="#000000"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="กรุงเทพมหานคร"
                                android:textColor="#000000"
                                android:textSize="12sp"
                                android:layout_marginTop="-5dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_tabianbuy_top2"
                    android:layout_width="140dp"
                    android:layout_height="65dp"
                    android:layout_margin="5dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#000000"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_plate_buy_top2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4กค 4542"
                            android:fontFamily="@font/sarun"
                            android:textColor="#000000"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="กรุงเทพมหานคร"
                            android:textColor="#000000"
                            android:textSize="12sp"
                            android:layout_marginTop="-5dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_tabianbuy_top2_2"
                    android:layout_width="140dp"
                    android:layout_height="65dp"
                    android:layout_margin="5dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#000000"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_plate_buy_top2_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4กธ 4542"
                            android:fontFamily="@font/sarun"
                            android:textColor="#000000"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="กรุงเทพมหานคร"
                            android:textColor="#000000"
                            android:textSize="12sp"
                            android:layout_marginTop="-5dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>



            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <ImageView
                    android:src="@drawable/icon_luckycat24"
                    android:layout_width="40dp"
                    android:layout_height="40dp" />

                <TextView
                    android:id="@+id/chip_tabain_all"

                    android:text="รอการอัพเดททะเบียนรถเพิ่มเติมค่ะ"
                    android:layout_gravity="center_vertical"
                    android:textStyle="bold"
                    android:layout_marginStart="1dp"
                    app:chipBackgroundColor="#F8F7F7"

                    android:textColor="#FA801B"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>


        </LinearLayout>


    </LinearLayout>



        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F7F6F6">

            <LinearLayout
                android:paddingTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="9dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_marginTop="4dp"
                        android:src="@drawable/ic_clover" />

                    <TextView
                        android:id="@+id/txt_percent_d"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:padding="9dp"
                        android:textColor="#04B40B"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="ซื้อทะเบียนรถ หรือ เปิดดวงชะตา"
                        tools:text="ซื้อทะเบียนรถ หรือ เปิดดวงชะตา" />


                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_open_miracle"
                        android:text="CLICK"
                        android:textSize="11sp"
                        android:textColor="#FFF"
                        app:chipBackgroundColor="#00b106"
                        app:chipStrokeColor="#FFF"
                        app:chipStrokeWidth="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        app:chipStartPadding="20dp"
                        app:chipEndPadding="20dp"
                        app:chipMinHeight="44dp" />

                </LinearLayout>





            </LinearLayout>

        </FrameLayout>

        <include layout="@layout/item_footer"/>

    </LinearLayout>





</RelativeLayout>

    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>